---
import { ViewTransitions } from 'astro:transitions';
import Whatsapp from '../components/whatsapp/whatsapp.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <link rel="icon" type="image/png" href="/logoEmpresa.png" />
  <title>Alagro</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-843758Q2RH"></script>

    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-843758Q2RH');
    </script>

    <script is:inline>
        document.addEventListener('astro:page-load', () => {
        gtag('config', 'G-843758Q2RH', {
            page_path: window.location.pathname,
        });
        });
    </script>

  <ViewTransitions />
</head>

<body>

    <main>
        <slot />
    </main>
    <Whatsapp/>

</body>
</html>


