---
import Sidebar from '../../sidebar/sidebar.astro';
import '../menuHeader.css';
import '../trabaja/nosotros.css';
---

<div class="page-container">
    <Sidebar active="trabaja" />

    <main class="content">
        <section>
            <h2>Trabaja con Nosotros</h2>

            <p>
                En <strong>ALAGRO</strong> buscamos personas comprometidas, apasionadas por el desarrollo del campo 
                y con vocación de servicio. Si deseas hacer parte de nuestro equipo, envíanos tu información.
            </p>

            <!-- FORMULARIO -->
            <div class="form-container">
                <form action="/trabaja-con-nosotros" method="POST" enctype="multipart/form-data" class="form">

                    <div class="form-group">
                        <label>Nombre completo <span class="required">*</span></label>
                        <input type="text" name="nombre" required />
                    </div>

                    <div class="form-group">
                        <label>Correo electrónico <span class="required">*</span></label>
                        <input type="email" name="correo" required />
                    </div>

                    <div class="form-group">
                        <label>Celular <span class="required">*</span></label>
                        <input type="tel" name="telefono" required />
                    </div>

                    <div class="form-group">
                        <label>Mensaje <span class="required">*</span></label>
                        <textarea name="mensaje" rows="4" placeholder="Cuéntanos sobre ti"></textarea>
                    </div>

                    <!-- ADJUNTO -->
                    <div class="form-group">
                        <label>Adjuntar hoja de vida (PDF) <span class="required">*</span></label>
                        <input type="file" name="cv" accept=".pdf" required />
                    </div>

                    <button type="submit" class="btn-submit">
                        Enviar solicitud
                    </button>
                </form>
            </div>

        </section>
    </main>
</div>

