---
import '../gestion.css';

import { gestionSolidaria } from '../../../data/gestionSolidaria.js';
---

<div class="gestiones-bg">
  <main class="container gestiones-page">

    <section class="productos-grid">
      {gestionSolidaria.map((gestion:any) => (
        <article class="producto-card">
          <img src={gestion.img} alt={gestion.name} class="producto-card-img" />
          <h3 class="producto-card-title">{gestion.name}</h3>

          <div class="producto-card-desc">
            {gestion.desc.map((parrafo: string) => (
              <p>{parrafo}</p>
            ))}
          </div>


          <button class="producto-card-link ver-mas">
            Ver más
          </button>
        </article>
      ))}
    </section>

  </main>
</div>

<script>
  document.addEventListener('click', (e:any) => {
    const btn = e.target.closest('.ver-mas');
    if (!btn) return;

    const currentCard = btn.closest('.producto-card');
    const allCards = document.querySelectorAll('.producto-card');

    const isExpanded = currentCard.classList.contains('expanded');

    // 🔥 Cerrar todas primero
    allCards.forEach(card => {
      card.classList.remove('expanded');
      const button = card.querySelector('.ver-mas');
      if (button) button.textContent = 'Ver más';
    });

    // 🔥 Si NO estaba abierta, abrirla
    if (!isExpanded) {
      currentCard.classList.add('expanded');
      btn.textContent = 'Ver menos';

      // 🔥 Scroll suave hacia la card
      setTimeout(() => {
        currentCard.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }, 150);
    }
  });
</script>