---

import './sidebar.css';

interface Props {
	active?: string;
}

const { active = "quienes_somos" } = Astro.props;
---

<aside class="sidebar">
	<div class="sidebar-header">
		<span class="icon">☆</span>
		<h3>Menú Nosotros</h3>
	</div>
	
	<nav class="sidebar-menu">
		<a href="/quienes_somos" class={`menu-link ${active === "quienes_somos" ? "active" : ""}`}>
			Quienes somos
			<span class="arrow">›</span>
		</a>

		<a href="/estatutos" class={`menu-link ${active === "estatutos" ? "active" : ""}`}>
			Códigos y estatutos
			<span class="arrow">›</span>
		</a>

		<a href="/asociados" class={`menu-link ${active === "asociados" ? "active" : ""}`}>
			Asociados
			<span class="arrow">›</span>
		</a>

		<a href="/informes/acta-constitucion" class={`menu-link ${active === "informes" ? "active" : ""}`}>
			Informes y balances
			<span class="arrow">›</span>
		</a>

		<a href="/trabaja-con-nosotros" class={`menu-link ${active === "trabaja" ? "active" : ""}`}>
			Trabaja con nosotros
			<span class="arrow">›</span>
		</a>
		
	</nav>
</aside>

